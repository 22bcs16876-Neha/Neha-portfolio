# ==============================================================================
# PORTFOLIO APPLICATION ENVIRONMENT CONFIGURATION
# Copy this file to .env and provide your production database credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / MySQL / Supabase / Neon / Railway)
# ------------------------------------------------------------------------------
# The backend automatically supports:
# - PostgreSQL: postgresql://... OR jdbc:postgresql://...
# - MySQL:      mysql://...      OR jdbc:mysql://...
# - Supabase / Neon / Railway / Render / AWS RDS / Clever Cloud
#
# Option A: Full Connection URI / JDBC URL (Recommended)
# Works directly with Supabase, Neon, Railway, or Render connection strings!
DATABASE_URL=jdbc:postgresql://your-db-host.com:5432/your_database_name?sslmode=require
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_database_password

# Option B: Standard Spring Boot Datasource Variables (Alternative)
# SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host.com:3306/portfolio_db?useSSL=true
# SPRING_DATASOURCE_USERNAME=your_mysql_username
# SPRING_DATASOURCE_PASSWORD=your_mysql_password

# ------------------------------------------------------------------------------
# 2. SERVER & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Port for Spring Boot backend (Render, Railway, and Heroku automatically provide PORT)
PORT=8080

# Production JWT Secret (must be at least 32 characters long)
JWT_SECRET=production_super_secret_jwt_key_at_least_32_characters_long_2026_xyz

# JWT Token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. INITIAL ADMIN CMS CREDENTIALS
# (Automatically created in fresh empty databases upon first startup)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_EMAIL=your_email@domain.com

# ------------------------------------------------------------------------------
# 4. CORS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend domains or '*' for open access:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-portfolio.vercel.app,*

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (For Vercel / Netlify / Client build)
# ------------------------------------------------------------------------------
# When deploying the frontend separately, point this to your production backend URL:
# VITE_API_URL=https://your-backend-service.onrender.com/api
