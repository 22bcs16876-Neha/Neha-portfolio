# Spring Boot Backend Environment Variables
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration
# For MySQL:
DB_URL=jdbc:mysql://localhost:3306/portfolio_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=portfolio_user
DB_PASSWORD=portfolio_secure_password

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security_production
JWT_EXPIRATION_MS=86400000

# Default Seed Admin Credentials (used if no admin user exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeInAdmin123!
ADMIN_EMAIL=admin@example.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-portfolio.netlify.app
